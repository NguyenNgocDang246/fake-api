# App URLs
DOMAIN="http://localhost:3000"
NEXT_PUBLIC_DOMAIN="http://localhost:3000"

# Optional: public docs link (used by UI if wired up)
NEXT_PUBLIC_DOCS_URL="https://www.notion.so/your-docs-page"

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/FakeAPI?schema=public"
# Optional: Prisma Accelerate / Data Proxy connection string
DATABASE_URL_PROXY="prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY"

# Auth/JWT secrets (generate strong random values in production)
ACCESS_SECRET="CHANGE_ME"
REFRESH_SECRET="CHANGE_ME"
RESET_PASSWORD_SECRET="CHANGE_ME"
VERIFY_EMAIL_SECRET="CHANGE_ME"

# Misc
DUMMY_PASSWORD_SALT="CHANGE_ME"
NODE_ENV="development"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Email (Resend)
RESEND_API_KEY="YOUR_RESEND_API_KEY"
