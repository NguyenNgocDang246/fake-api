# App URLs
DOMAIN="http://localhost:3000"
# Canonical URLs, the sitemap and the OG image all resolve against NEXT_PUBLIC_DOMAIN, so in
# production it must be the absolute public URL including the scheme. A production build
# without it fails on purpose rather than shipping canonical tags that point at localhost.
NEXT_PUBLIC_DOMAIN="http://localhost:3000"


# Database
# DATABASE_URL is what the app queries through. On Neon this must be the pooled
# connection string (hostname ends with "-pooler").
DATABASE_URL="postgresql://username:password@localhost:5432/FakeAPI?schema=public"
# DIRECT_URL is only used by `prisma migrate`. Same string as DATABASE_URL with the
# "-pooler" suffix removed, since migrations need a direct connection.
DIRECT_URL="postgresql://username:password@localhost:5432/FakeAPI?schema=public"

# Auth/JWT secrets (generate strong random values in production)
ACCESS_SECRET="CHANGE_ME"
REFRESH_SECRET="CHANGE_ME"
RESET_PASSWORD_SECRET="CHANGE_ME"
VERIFY_EMAIL_SECRET="CHANGE_ME"

# Misc
DUMMY_PASSWORD_SALT="CHANGE_ME"
NODE_ENV="development"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Email (Resend)
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# AI Providers
#
# Leave AI_PROVIDERS empty to turn the feature off entirely: the UI hides the whole AI
# block instead of letting anyone click through to an error.
#
# AI_PROVIDERS is a priority order, not a rotation. The first provider handles every call,
# and a later one is only reached after the ones before it fail, so the list is a fallback
# chain. Gemini leads here because a flash model is the cheap fit for generating small
# mock payloads; Anthropic sits behind it as the fallback. Drop either name to disable it.
#
# Each provider reads <NAME>_API_KEYS and <NAME>_MODEL, derived from its name, so a new
# provider needs no extra wiring beyond its own two variables.
AI_PROVIDERS="gemini,anthropic"

# Comma separated. Round-robin applies here: every call takes the next key in the list, so
# several keys spread the load and a rate limited key falls through to the next one.
GEMINI_API_KEYS="YOUR_GEMINI_API_KEY"
ANTHROPIC_API_KEYS="YOUR_ANTHROPIC_API_KEY"

# One model per provider, not rotated. Omit a line to use that adapter's default.
GEMINI_MODEL="gemini-3.7-flash"
ANTHROPIC_MODEL="claude-opus-5"

# How fast this server as a whole will call a model. One window for the process, counted
# regardless of who is asking, so a runaway loop or a scripted client cannot outrun it.
# Read the pair as "calls per window": 10 and 1 is ten per second, 60 and 60 averages one per
# second while still allowing a burst. Set either to 0 to turn the limit off for local work.
#
# This is the only ceiling a request cannot rewind. The per-role daily quota counts rows in
# endpoint_ai_variants, so a preview slips past it (it stores nothing) and a create/delete loop
# resets it (the rows cascade away). Note it caps the rate, not the daily total.
AI_RATE_LIMIT_CALLS="10"
AI_RATE_LIMIT_WINDOW_SECONDS="1"
