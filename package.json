    "argon2": "^0.44.0",
    "axios": "^1.12.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.1",
    "googleapis": "^161.0.0",
    "hashids": "^2.3.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.7",
    "prisma": "^6.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.62.0",
    "react-toastify": "^11.0.5",
