{
  "name": "fake-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node test/backend/run-jest.cjs",
    "test:backend": "node test/backend/run-jest.cjs",
    "type-check": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "prisma:generate": "prisma generate --schema=src/server/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=src/server/prisma/schema.prisma",
    "prisma:backfill-public-id": "tsx src/server/prisma/scripts/backfill-public-id.ts",
    "prisma:explain": "tsx src/server/prisma/scripts/explain-endpoint-lookup.ts",
    "build": "npm run prisma:generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.16.3",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-query": "^5.90.2",
    "argon2": "^0.44.0",
    "axios": "^1.12.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.1",
    "googleapis": "^161.0.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "nanoid": "^3.3.8",
    "next": "^15.5.7",
    "prisma": "^6.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.62.0",
    "react-toastify": "^11.0.5",
    "resend": "^6.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.1.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  }
}
