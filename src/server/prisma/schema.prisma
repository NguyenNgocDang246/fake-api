generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model endpoint_groups {
  id         BigInt      @id @default(autoincrement())
  public_id  String      @unique @db.VarChar(12)
  project_id BigInt
  name       String      @db.VarChar(100)
  updated_at DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  projects   projects    @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  endpoints  endpoints[]

  @@index([project_id])
}
enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

/// Only what addresses an endpoint. Everything about the answer belongs to whichever of its
/// scenarios is active.
model endpoints {
  id                 BigInt               @id @default(autoincrement())
  public_id          String               @unique @db.VarChar(12)
  endpoint_groups_id BigInt
  method             HttpMethod
  path               String               @db.VarChar(255)
  updated_at         DateTime?            @default(now()) @updatedAt @db.Timestamp(6)
  endpoint_groups    endpoint_groups      @relation(fields: [endpoint_groups_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scenarios          endpoint_scenarios[]

  /// Serves the fake-API lookup. The join key leads, because the planner resolves the project
  /// first and only then joins into endpoints; a (method, path) index was never chosen.
  @@index([endpoint_groups_id, method, path])
}

/// One saved response for an endpoint: a 200 body, a 401 body, an admin-role body. The active
/// one is what a mock answers with, and switching is what an author does instead of editing the
/// body back and forth.
model endpoint_scenarios {
  id                 BigInt    @id @default(autoincrement())
  public_id          String    @unique @db.VarChar(12)
  endpoints_id       BigInt
  name               String    @db.VarChar(100)
  /// The order the pager shows them in, rewritten dense from 0 on every save. Deliberately not
  /// unique: a reorder would violate a unique constraint mid-statement.
  position           Int       @default(0)
  /// Held to at most one per endpoint by a partial unique index the migration creates, which
  /// Prisma has no way to declare. It says "at most", never "at least": a switch deactivates
  /// before it activates, so the serving lookup orders by (is_active desc, position asc) and
  /// takes one rather than filtering on this.
  is_active          Boolean   @default(false)
  status_code        Int       @default(200)
  response_body      String
  /// Headers the author wants on this scenario's response, as a JSON array of {name, value}.
  /// Read on the serving path, where they are layered over the defaults every mock carries.
  response_headers   String    @default("[]")
  /// Cookies this scenario sets, as a JSON array of rows. No row carries a Domain, so every one
  /// of them is host-only to `{project.public_id}.{DOMAIN}`: that is what keeps a mock cookie out
  /// of the app's own jar on the apex and out of every other project's. Appended one Set-Cookie
  /// per row on the serving path rather than layered, the way `response_headers` is.
  response_cookies   String    @default("[]")
  delay_ms           Int       @default(0)
  ai_enabled         Boolean   @default(false)
  ai_fields          String[]  @default([])
  ai_prompt          String?   @db.VarChar(500)
  /// The blueprint an LLM built for this scenario's body, as JSON. Executed by faker on every
  /// request, so it is read on the serving path and never written there.
  ai_plan            String?
  /// Hash of the inputs the blueprint was built from (body, sorted fields, hint). A mismatch
  /// is what makes the blueprint stale, and it is why the blueprint lives here rather than on
  /// the endpoint: it belongs to the body it was built for.
  ai_plan_hash       String?   @db.VarChar(64)
  ai_plan_at         DateTime? @db.Timestamp(6)
  /// Lock for building the blueprint, doubling as the retry cooldown after a failed build.
  ai_plan_started_at DateTime? @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  endpoints          endpoints @relation(fields: [endpoints_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Serves the pager and the serving path's lookup of the active one.
  @@index([endpoints_id, position])
}

/// Append only record of the calls a user spent on the AI, one row per model call.
/// The daily quota counts these rows. It used to count generated variants, which meant a
/// preview slipped past it entirely and a create/delete loop reset it.
model ai_usage_logs {
  id         BigInt   @id @default(autoincrement())
  users_id   BigInt
  kind       String   @db.VarChar(16)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [users_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Serves the per user daily quota count.
  @@index([users_id, created_at])
}

model projects {
  id              BigInt            @id @default(autoincrement())
  public_id       String            @unique @db.VarChar(12)
  user_id         BigInt
  name            String            @db.VarChar(100)
  description     String?
  /// Off is how an author reproduces a browser blocking their call, so the mock still answers
  /// curl while sending no CORS header at all.
  cors_enabled           Boolean    @default(true)
  /// Empty means any origin, which is what every project starts on.
  cors_origins           String[]   @default([])
  /// Cannot pair with the empty origin list: credentials and a wildcard origin are not a
  /// combination the browser accepts.
  cors_allow_credentials Boolean    @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  endpoint_groups endpoint_groups[]
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

model users {
  id             BigInt     @id @default(autoincrement())
  public_id      String     @unique @db.VarChar(12)
  email          String     @unique @db.VarChar(100)
  password       String     @db.VarChar(255)
  name           String     @db.VarChar(255)
  token_version  BigInt    @db.BigInt @default(0)
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  updated_at     DateTime?  @default(now()) @updatedAt @db.Timestamp(6)
  role           String     @db.VarChar(50) @default("USER")
  is_verified    Boolean    @default(false)
  projects       projects[]
  ai_usage_logs  ai_usage_logs[]
}

